---
import Browsers from "../components/Browsers.astro";
import FAQ from "../components/FAQ.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Navbar from "../components/Navbar.astro";
import Requirements from "../components/Requirements.astro";
import Support from "../components/Support.astro";
import WhyAutomate from "../components/WhyAutomate.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Navbar />
	<main id="main-content" tabindex="-1" class="flex-grow outline-none focus:outline-none focus-visible:outline-none">
		<Hero />
		<WhyAutomate />
		<HowItWorks />
		<Features />
		<Browsers />
		<Requirements />
		<Support />
		<FAQ />
	</main>
	<Footer />
</Layout>
