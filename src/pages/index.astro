---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhyAutomate from '../components/WhyAutomate.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Browsers from '../components/Browsers.astro';
import Requirements from '../components/Requirements.astro';
import Support from '../components/Support.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Navbar />
	<main id="main-content" tabindex="-1" class="flex-grow focus:outline-none">
		<Hero />
		<WhyAutomate />
		<HowItWorks />
		<Features />
		<Browsers />
		<Requirements />
		<Support />
		<FAQ />
	</main>
	<Footer />
</Layout>
