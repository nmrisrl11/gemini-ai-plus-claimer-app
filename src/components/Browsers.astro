---
import {
	AppWindow as AppWindowIcon,
	ChevronRight as ChevronRightIcon,
	Globe as GlobeIcon,
	Info as InfoIcon,
	ShieldCheck as ShieldCheckIcon,
	Zap as ZapIcon,
} from "@lucide/astro";
import { BROWSER_TIERS, CASCADE_STEPS } from "../constants/browsers";

const BROWSER_ICONS = {
	globe: GlobeIcon,
	"shield-check": ShieldCheckIcon,
	zap: ZapIcon,
	"app-window": AppWindowIcon,
} as const;
---

<!-- Multi-Browser Compatibility Section -->
<section
	id="browsers"
	class="py-16 md:py-24 border-b border-slate-800 bg-slate-950/40 relative overflow-hidden"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
			<span
				class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 font-mono text-xs font-semibold uppercase tracking-wider"
			>
				<span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
				Universal Compatibility
			</span>
			<h2
				class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-3"
			>
				Universal Multi-Browser Engine
			</h2>
			<p class="text-slate-300 mt-4 text-sm sm:text-base leading-relaxed">
				Runs directly on the browser already on your machine. Google AI Plus Portal features
				an intelligent 5-tier discovery cascade—automatically adapting to your existing
				Chromium installation with zero manual setup.
			</p>
		</div>

		<!-- Browser Cards Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
			{
				BROWSER_TIERS.map((tier) => {
					const IconComponent = BROWSER_ICONS[tier.icon];
					return (
						<div class="group relative rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 hover:bg-slate-900/90 transition-all">
							<div>
								<div class="flex items-center justify-between mb-4">
									<div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center group-hover:border-sky-500/40 group-hover:bg-sky-500/15 transition-all">
										<IconComponent class="w-5 h-5" />
									</div>
									<div class="flex items-center gap-1.5">
										<span class="font-mono text-xs font-bold text-sky-400">
											T{tier.tier}
										</span>
										<span class="text-slate-600 text-xs" aria-hidden="true">
											&bull;
										</span>
										<span class="text-[10px] font-mono text-slate-400 px-2 py-0.5 rounded bg-slate-950 border border-slate-800 group-hover:border-slate-700 transition-colors">
											{tier.tierBadge}
										</span>
									</div>
								</div>
								<h3 class="text-base font-bold text-white mb-2 tracking-tight group-hover:text-sky-300 transition-colors">
									{tier.name}
								</h3>
								<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
									{tier.description}
								</p>
							</div>

							<div class="mt-5 pt-3.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono">
								<span class="text-slate-500 uppercase tracking-wider text-[10px]">
									{tier.engineLabel}
								</span>
								<span class="text-slate-300">
									{tier.engineValue}
								</span>
							</div>
						</div>
					);
				})
			}
		</div>

		<!-- Bottom Architecture Explanation Banner (Visual Sequential Cascade) -->
		<div
			class="mt-8 p-5 sm:p-6 rounded-2xl border border-slate-800/80 bg-slate-900/40 relative overflow-hidden"
		>
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div class="flex items-start gap-3.5 max-w-xl">
					<div
						class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center shrink-0 mt-0.5"
					>
						<InfoIcon class="w-4 h-4" />
					</div>
					<div>
						<h4 class="text-sm font-semibold text-white">How the Discovery Cascade Operates</h4>
						<p class="text-xs text-slate-400 mt-1 leading-relaxed">
							The portal executes an automated 5-tier fallback sequence. It detects and binds to your pre-installed Windows Chromium browser without requiring Python environments or external downloads.
						</p>
					</div>
				</div>

				<!-- Visual Step Sequence -->
				<div class="flex flex-wrap items-center gap-2 font-mono text-xs">
					{
						CASCADE_STEPS.map((step, idx) => (
							<div class="flex items-center gap-2">
								<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-950 border border-slate-800 text-slate-300">
									<span class="text-sky-400 text-[10px] font-bold">{step.step}</span>
									<span>{step.label}</span>
								</span>
								{idx < CASCADE_STEPS.length - 1 && (
									<ChevronRightIcon class="w-3.5 h-3.5 text-slate-600 shrink-0" />
								)}
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
