---
import {
	AppWindow as AppWindowIcon,
	Globe as GlobeIcon,
	Info as InfoIcon,
	ShieldCheck as ShieldCheckIcon,
	Zap as ZapIcon,
} from "@lucide/astro";
---

<!-- Multi-Browser Compatibility Section -->
<section
	id="browsers"
	class="py-16 md:py-24 border-b border-slate-800 bg-slate-950/40 relative overflow-hidden"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
			<span
				class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 font-mono text-xs font-semibold uppercase tracking-wider"
			>
				<span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
				Universal Compatibility
			</span>
			<h2
				class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-3"
			>
				Universal Multi-Browser Engine
			</h2>
			<p class="text-slate-300 mt-4 text-sm sm:text-base leading-relaxed">
				Runs directly on the browser already on your machine. Google AI Plus Portal features
				an intelligent 5-tier discovery cascade—automatically adapting to your existing
				Chromium installation with zero manual setup.
			</p>
		</div>

		<!-- Browser Cards Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
			<!-- Card 1: Google Chrome -->
			<div
				class="rounded-xl border border-slate-800 bg-slate-900/90 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 transition-colors"
			>
				<div>
					<div class="flex items-center justify-between mb-4">
						<div
							class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center"
						>
							<GlobeIcon class="w-5 h-5" />
						</div>
						<span
							class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20"
							>Tier 1 • Primary</span
						>
					</div>
					<h3 class="text-base font-bold text-white mb-1.5">Google Chrome</h3>
					<p class="text-xs text-slate-400 leading-relaxed">
						Direct headless connection via standard Chrome distribution channels for maximum
						execution speed.
					</p>
				</div>
				<div
					class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] font-mono text-slate-400"
				>
					Channel: <span class="text-slate-300">chrome</span>
				</div>
			</div>

			<!-- Card 2: Microsoft Edge -->
			<div
				class="rounded-xl border border-slate-800 bg-slate-900/90 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 transition-colors"
			>
				<div>
					<div class="flex items-center justify-between mb-4">
						<div
							class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center"
						>
							<ShieldCheckIcon class="w-5 h-5" />
						</div>
						<span
							class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
							>Tier 2 • Built-in</span
						>
					</div>
					<h3 class="text-base font-bold text-white mb-1.5">Microsoft Edge</h3>
					<p class="text-xs text-slate-400 leading-relaxed">
						Pre-installed on 100% of Windows 10 &amp; 11 PCs. Guarantees the portal runs out
						of the box with zero downloads.
					</p>
				</div>
				<div
					class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] font-mono text-slate-400"
				>
					Channel: <span class="text-slate-300">msedge</span>
				</div>
			</div>

			<!-- Card 3: Brave Browser -->
			<div
				class="rounded-xl border border-slate-800 bg-slate-900/90 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 transition-colors"
			>
				<div>
					<div class="flex items-center justify-between mb-4">
						<div
							class="w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center"
						>
							<ZapIcon class="w-5 h-5" />
						</div>
						<span
							class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-orange-500/10 text-orange-400 border border-orange-500/20"
							>Tier 3 • Privacy</span
						>
					</div>
					<h3 class="text-base font-bold text-white mb-1.5">Brave Browser</h3>
					<p class="text-xs text-slate-400 leading-relaxed">
						Deep path resolution for privacy-first developers running Brave as their default
						Windows browser.
					</p>
				</div>
				<div
					class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] font-mono text-slate-400"
				>
					Detection: <span class="text-slate-300">Brave Application</span>
				</div>
			</div>

			<!-- Card 4: Opera & Vivaldi -->
			<div
				class="rounded-xl border border-slate-800 bg-slate-900/90 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 transition-colors"
			>
				<div>
					<div class="flex items-center justify-between mb-4">
						<div
							class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center"
						>
							<AppWindowIcon class="w-5 h-5" />
						</div>
						<span
							class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20"
							>Tier 4 • Extended</span
						>
					</div>
					<h3 class="text-base font-bold text-white mb-1.5">Opera &amp; Vivaldi</h3>
					<p class="text-xs text-slate-400 leading-relaxed">
						Automatic user and program directory scanning for Chromium-powered community
						browsers.
					</p>
				</div>
				<div
					class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] font-mono text-slate-400"
				>
					Scanning: <span class="text-slate-300">Auto-Detected</span>
				</div>
			</div>
		</div>

		<!-- Bottom Architecture Explanation Banner -->
		<div
			class="mt-8 p-4 sm:p-6 rounded-xl border border-slate-800/80 bg-slate-900/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
		>
			<div class="flex items-start gap-3.5">
				<div
					class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center shrink-0 mt-0.5"
				>
					<InfoIcon class="w-4 h-4" />
				</div>
				<div>
					<div class="text-sm font-semibold text-white">How the Discovery Cascade Works</div>
					<div class="text-xs text-slate-400 mt-0.5 leading-relaxed">
						The portal tests Chrome first &rarr; falls back to pre-installed Edge &rarr;
						searches direct executable paths for Brave, Opera &amp; Vivaldi &rarr; inspects
						Playwright cache. If you have any modern Windows computer, it works right out of
						the box.
					</div>
				</div>
			</div>
			<div class="shrink-0 flex items-center gap-2 self-end sm:self-center">
				<span
					class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-medium text-emerald-400"
				>
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
					0MB Extra Downloads
				</span>
			</div>
		</div>
	</div>
</section>
