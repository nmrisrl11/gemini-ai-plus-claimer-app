---
import { Info as InfoIcon } from "@lucide/astro";
import { REDEMPTION_GUIDELINES, SYSTEM_SPECS } from "../constants/requirements";
---

<!-- System Requirements & Google Constraints Section -->
<section id="requirements" class="py-16 md:py-24 border-b border-slate-800 bg-slate-900/10">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Unified Split-Pane Technical Specification Panel -->
		<div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden shadow-xl">
			<div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-800">
				<!-- Left Pane: System Specifications -->
				<div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
					<div>
						<div class="mb-8">
							<span class="text-xs font-bold uppercase tracking-wider text-sky-400">
								Specifications
							</span>
							<h2 class="text-2xl font-extrabold text-white tracking-tight mt-1">
								System Requirements
							</h2>
							<p class="text-sm text-slate-400 mt-2">
								Minimal prerequisites to execute the standalone automation engine on Windows.
							</p>
						</div>

						<div class="divide-y divide-slate-800/80">
							{
								SYSTEM_SPECS.map((spec) => (
									<div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 text-sm">
										<span class="text-slate-400 font-medium text-xs sm:text-sm">
											{spec.label}
										</span>
										<span
											class={`text-slate-200 text-xs sm:text-sm ${
												spec.mono ? "font-mono" : ""
											} text-left sm:text-right`}
										>
											{spec.value}
										</span>
									</div>
								))
							}
						</div>
					</div>

					<div class="mt-8 pt-6 border-t border-slate-800/80 flex items-start gap-3">
						<InfoIcon class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" />
						<p class="text-xs text-slate-400 leading-relaxed">
							<strong class="text-slate-300 font-semibold">Zero-Dependency Engine:</strong>{" "}
							The utility bundles all automation components. It binds to your existing browser with no external compilers, libraries, or Python paths required.
						</p>
					</div>
				</div>

				<!-- Right Pane: Redemption Guidelines & Notes -->
				<div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-between bg-slate-950/20">
					<div>
						<div class="mb-8">
							<span class="text-xs font-bold uppercase tracking-wider text-sky-400">
								Account Advisory
							</span>
							<h2 class="text-2xl font-extrabold text-white tracking-tight mt-1">
								Google One Redemption Rules
							</h2>
							<p class="text-sm text-slate-400 mt-2">
								Key upstream account constraints and activation policies to keep in mind.
							</p>
						</div>

						<div class="space-y-6">
							{
								REDEMPTION_GUIDELINES.map((item) => (
									<div class="flex items-start gap-3.5">
										<span class="font-mono text-sm font-bold text-sky-400 shrink-0 mt-0.5">
											{item.step}
										</span>
										<div>
											<h3 class="text-sm font-bold text-white mb-1.5 tracking-tight">
												{item.title}
											</h3>
											<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
												{item.description}
											</p>
										</div>
									</div>
								))
							}
						</div>
					</div>

					<div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center gap-2 text-xs text-slate-500">
						<span class="w-1.5 h-1.5 rounded-full bg-slate-600 shrink-0" />
						<span>Official Google One promotion policy applies. One redemption per eligible Google account.</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
