---
import {
	Check as CheckIcon,
	ExternalLink as ExternalLinkIcon,
	RefreshCw as RefreshCwIcon,
} from "@lucide/astro";
import { CONFIG } from "../config";
import WindowsIcon from "./icons/WindowsIcon.astro";
---

<!-- Hero Section -->
<section
	id="overview"
	class="relative pt-10 pb-14 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 border-b border-slate-800 overflow-hidden"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Hero Header -->
		<div class="text-center max-w-3xl mx-auto">
			<!-- Hero Headline -->
			<h1
				class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight mb-4 sm:mb-6"
			>
				Automate your 1-Year Google AI Plus access.
				<span class="block text-sky-400 mt-1 sm:mt-2">Locally. Effortlessly.</span>
			</h1>

			<!-- Hero Description -->
			<p
				class="text-sm sm:text-base md:text-lg text-slate-300 leading-relaxed mb-6 sm:mb-8 max-w-2xl mx-auto"
			>
				An independent, open-source Windows automation tool engineered to streamline student
				educational onboarding and capture promotional Google One redemption links locally in
				your browser.
			</p>

			<!-- Primary CTA Button & Releases Link -->
			<div class="flex flex-col items-center justify-center gap-3 mb-6">
				<a
					id="btn-download-hero"
					href={CONFIG.LATEST_RELEASE_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="direct-download-link w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-lg bg-sky-700 hover:bg-sky-600 text-white font-semibold text-sm sm:text-base transition-all duration-150 border border-sky-500/30 shadow-lg shadow-sky-950/40 focus:outline-none focus:ring-2 focus:ring-sky-400"
				>
					<!-- Windows Logo -->
					<WindowsIcon class="w-5 h-5 fill-current shrink-0" />
					<span>Download for Windows (64-bit)</span>
				</a>
				<a
					href={CONFIG.RELEASES_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="releases-link inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-sky-300 transition-colors font-medium group"
				>
					<span>View all releases &amp; changelog<span class="sr-only"> (opens in a new tab)</span></span>
					<ExternalLinkIcon class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 text-slate-400 group-hover:text-sky-300" />
				</a>
			</div>

			<!-- Micro specs under CTA -->
			<div
				class="flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-slate-400"
			>
				<span class="flex items-center gap-1.5">
					<CheckIcon class="w-4 h-4 text-emerald-400" />
					No installation needed
				</span>
				<span class="flex items-center gap-1.5">
					<CheckIcon class="w-4 h-4 text-emerald-400" />
					Uses pre-installed Chrome or Edge
				</span>
				<span class="flex items-center gap-1.5">
					<CheckIcon class="w-4 h-4 text-emerald-400" />
					100% Local execution
				</span>
			</div>
		</div>

		<!-- Realistic App UI Mockup -->
		<div class="mt-12 max-w-4xl mx-auto">
			<div
				role="region"
				aria-label="Desktop application interface preview"
				class="rounded-xl border border-slate-700/80 bg-slate-900 shadow-2xl overflow-hidden"
			>
				<!-- Window Title Bar with Windows Native Controls -->
				<div
					class="bg-slate-950 px-3.5 sm:px-4 py-2 border-b border-slate-800 flex items-center justify-between select-none"
				>
					<div class="flex items-center gap-2 sm:gap-2.5 min-w-0">
						<img
							src="/images/app_icon.png"
							alt=""
							aria-hidden="true"
							class="w-4 h-4 object-contain shrink-0"
							width="16"
							height="16"
						/>
						<span class="text-xs font-mono font-medium text-slate-300 truncate">
							<span class="sm:hidden">Google AI Plus Portal</span>
							<span class="hidden sm:inline">Google AI Plus (1-Year Access) Portal</span>
						</span>
					</div>
					<div
						class="flex items-center gap-3 sm:gap-4 shrink-0 text-slate-300 text-xs font-mono pr-1"
						aria-hidden="true"
					>
						<span class="hover:text-white cursor-default select-none">&#9472;</span>
						<span class="hover:text-white cursor-default select-none text-[11px]">&#9633;</span>
						<span class="hover:text-rose-400 cursor-default select-none text-sm">&#10005;</span>
					</div>
				</div>

				<!-- App Header Banner -->
				<div class="bg-slate-900 px-4 sm:px-6 py-4 border-b border-slate-800 text-center">
					<div class="text-base sm:text-lg font-bold text-slate-50 tracking-tight">
						Google AI Plus — 1-Year Access Portal
					</div>
					<div class="text-[11px] sm:text-xs text-slate-400 mt-0.5">
						Automated 12-Month Gemini Advanced &amp; Google AI Plus Promotional Utility
					</div>
				</div>

				<!-- Mock App Body -->
				<div class="p-4 sm:p-6 space-y-4 bg-slate-950/60">
					<!-- Card: Account Profile & Setup -->
					<div class="rounded-lg border border-slate-800 bg-slate-900 p-3.5 sm:p-4">
						<div
							class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800/80 gap-2"
						>
							<span class="text-xs sm:text-sm font-bold text-sky-400 truncate">
								Account Profile &amp; Setup
							</span>
							<div
								class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1 rounded bg-slate-800 border border-slate-700 text-slate-300 text-xs font-medium cursor-default"
							>
								<RefreshCwIcon class="w-3.5 h-3.5 text-slate-400" />
								<span>Randomize Info</span>
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
							<div class="flex items-center gap-2">
								<label class="w-28 text-slate-300 shrink-0">Candidate Name:</label>
								<div
									class="w-full bg-slate-950 border border-slate-700/80 rounded px-3 py-1.5 text-slate-200 font-mono"
								>
									Advik Malhotra
								</div>
							</div>
							<div class="flex items-center gap-2">
								<label class="w-28 text-slate-300 shrink-0">Institution:</label>
								<div
									class="w-full bg-slate-950 border border-slate-700/80 rounded px-3 py-1.5 text-slate-200 font-mono"
								>
									Engineering Institute
								</div>
							</div>
							<div class="flex items-center gap-2">
								<label class="w-28 text-slate-300 shrink-0">Academic Field:</label>
								<div
									class="w-full bg-slate-950 border border-slate-700/80 rounded px-3 py-1.5 text-slate-200 font-mono truncate"
								>
									Computer Science
								</div>
							</div>
							<div class="flex items-center gap-2">
								<label class="w-28 text-slate-300 shrink-0">Graduation Year:</label>
								<div
									class="w-full bg-slate-950 border border-slate-700/80 rounded px-3 py-1.5 text-slate-200 font-mono"
								>
									2026
								</div>
							</div>
							<div class="flex items-center gap-2">
								<label class="w-28 text-slate-300 shrink-0">Automation Engine:</label>
								<div
									class="w-full bg-slate-950 border border-slate-700/80 rounded px-3 py-1.5 text-slate-200 font-mono"
								>
									Auto Cascade (Chrome/Edge/Brave)
								</div>
							</div>
							<div class="hidden sm:block"></div>
						</div>
					</div>

					<!-- Action Buttons -->
					<div class="flex flex-wrap items-center justify-between gap-3 pt-0.5">
						<div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
							<span
								class="inline-flex items-center px-4 py-2.5 rounded-lg bg-sky-700 text-white font-semibold text-xs shadow-sm"
							>
								Get 1-Year Access Link
							</span>
							<span
								class="inline-flex items-center px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold"
							>
								Reset Fields
							</span>
						</div>
						<a
							href="#support"
							class="inline-flex items-center px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-200 hover:text-white text-xs font-semibold transition-colors"
						>
							Support Dev
						</a>
					</div>

					<!-- Visual Stepper Bar -->
					<div
						class="rounded-lg border border-slate-800 bg-slate-900/80 px-4 py-2.5 flex items-center justify-center text-xs font-medium gap-2 sm:gap-6 overflow-x-auto no-scrollbar whitespace-nowrap"
					>
						<span class="text-sky-400 font-bold flex items-center gap-1.5 shrink-0">
							<span
								class="w-4 h-4 rounded-full bg-sky-500/20 border border-sky-400 text-sky-300 flex items-center justify-center text-[10px]"
								>1</span
							>
							Profile Setup
						</span>
						<span class="text-slate-600 shrink-0">──────▶</span>
						<span class="text-slate-400 flex items-center gap-1.5 shrink-0">
							<span
								class="w-4 h-4 rounded-full bg-slate-800 border border-slate-700 text-slate-400 flex items-center justify-center text-[10px]"
								>2</span
							>
							Email Verification
						</span>
						<span class="text-slate-600 shrink-0">──────▶</span>
						<span class="text-slate-400 flex items-center gap-1.5 shrink-0">
							<span
								class="w-4 h-4 rounded-full bg-slate-800 border border-slate-700 text-slate-400 flex items-center justify-center text-[10px]"
								>3</span
							>
							Access Link Ready
						</span>
					</div>

					<!-- Live Activity Feed Card -->
					<div class="rounded-lg border border-slate-800 bg-slate-900 p-3.5 sm:p-4">
						<div
							class="flex items-center justify-between pb-2.5 mb-2.5 border-b border-slate-800 text-xs"
						>
							<span class="font-bold text-slate-100">Live Activity Feed</span>
							<span
								class="text-emerald-400 flex items-center gap-1.5 font-medium text-[11px]"
							>
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
								System Ready
							</span>
						</div>

						<div
							class="rounded bg-slate-950 border border-slate-800/80 p-3 font-mono text-[11px] leading-relaxed text-slate-300 overflow-x-auto"
						>
							<div class="text-sky-400/60 border-b border-sky-500/30 my-1"></div>
							<div class="text-slate-200 font-bold">
								GOOGLE AI PLUS — 1-YEAR ACCESS PROVISIONER
							</div>
							<div class="text-sky-400/60 border-b border-sky-500/30 my-1"></div>
							<div class="text-emerald-400 font-medium">Status: System Ready</div>
							<div class="text-slate-400 mt-1.5">Quick Guide:</div>
							<div class="text-slate-400">
								1. Review or customize your account profile above.
							</div>
							<div class="text-slate-400">
								2. Click "Get 1-Year Access Link" to start provisioning.
							</div>
							<div class="text-slate-400">
								3. Complete the email confirmation step when prompted by the browser.
							</div>
							<div class="text-slate-400">
								4. Your 1-Year Google AI Plus activation link will be ready to use!
							</div>
							<div class="text-sky-400/60 border-b border-sky-500/30 my-1"></div>
							<div class="text-slate-300 mt-1">
								<span class="text-sky-400">&gt;</span> Awaiting user execution...<span
									class="term-cursor"
								></span>
							</div>
						</div>
					</div>
				</div>

				<!-- In-App Desktop Window Footer -->
				<div
					class="px-4 sm:px-6 py-2.5 bg-slate-950 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400"
				>
					<div
						class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap"
					>
						<span>Developed by <span class="text-slate-300 font-medium">@nmrisrl11</span></span>
						<span>&bull;</span>
						<a href={CONFIG.REPO_URL} class="text-slate-400 hover:text-slate-200 transition-colors">About</a>
						<span>&bull;</span>
						<a href={CONFIG.BMC_URL} class="text-slate-400 hover:text-amber-300 transition-colors">Buy Me a Coffee</a>
					</div>
					<span class="font-mono text-slate-400 text-[10px] shrink-0">{CONFIG.VERSION}</span>
				</div>
			</div>
			<p class="text-center text-xs text-slate-400 mt-3 font-mono">
				Interactive desktop preview of the portable Windows utility application.
			</p>
		</div>
	</div>
</section>

<!-- Value Stats Bar -->
<section
	class="border-b border-slate-800 bg-slate-900/50 py-8 sm:py-10"
	aria-label="Key Guarantees"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 text-center">
			<div class="p-3 sm:p-4 rounded-xl border border-slate-800 bg-slate-900/80">
				<div class="text-xl sm:text-2xl md:text-3xl font-extrabold text-sky-400 font-mono">
					12 Months
				</div>
				<div class="text-xs sm:text-sm text-slate-300 font-medium mt-1">
					Gemini Advanced Access
				</div>
				<div class="text-[10px] sm:text-[11px] text-slate-400 mt-0.5">
					Includes 2TB Google One Storage
				</div>
			</div>

			<div class="p-3 sm:p-4 rounded-xl border border-slate-800 bg-slate-900/80">
				<div class="text-xl sm:text-2xl md:text-3xl font-extrabold text-emerald-400 font-mono">
					100% Local
				</div>
				<div class="text-xs sm:text-sm text-slate-300 font-medium mt-1">Zero Telemetry</div>
				<div class="text-[10px] sm:text-[11px] text-slate-400 mt-0.5">
					No cloud relays or external logging
				</div>
			</div>

			<div class="p-3 sm:p-4 rounded-xl border border-slate-800 bg-slate-900/80">
				<div class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white font-mono">
					0 MB Bloat
				</div>
				<div class="text-xs sm:text-sm text-slate-300 font-medium mt-1">
					System Browser Engine
				</div>
				<div class="text-[10px] sm:text-[11px] text-slate-400 mt-0.5">
					Attaches to installed Chrome or Edge
				</div>
			</div>

			<div class="p-3 sm:p-4 rounded-xl border border-slate-800 bg-slate-900/80">
				<div class="text-xl sm:text-2xl md:text-3xl font-extrabold text-sky-300 font-mono">
					1-Click
				</div>
				<div class="text-xs sm:text-sm text-slate-300 font-medium mt-1">
					Canonical Link Grab
				</div>
				<div class="text-[10px] sm:text-[11px] text-slate-400 mt-0.5">
					Auto-saved to local results folder
				</div>
			</div>
		</div>
	</div>
</section>
