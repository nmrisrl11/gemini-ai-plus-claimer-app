---
import {
	Layers as LayersIcon,
	Link2 as Link2Icon,
	Mail as MailIcon,
	ShieldCheck as ShieldCheckIcon,
	Terminal as TerminalIcon,
	TriangleAlert as TriangleAlertIcon,
} from "@lucide/astro";
import { ENGINEERING_FEATURES } from "../constants/features";

const FEATURE_ICONS = {
	layers: LayersIcon,
	"shield-check": ShieldCheckIcon,
	link: Link2Icon,
	mail: MailIcon,
	"triangle-alert": TriangleAlertIcon,
	terminal: TerminalIcon,
} as const;
---

<!-- Key Features Grid (Engineered, No AI Slop) -->
<section id="features" class="py-16 md:py-24 border-b border-slate-800 bg-slate-900/10">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-3xl mb-12 sm:mb-16">
			<span class="text-xs font-bold uppercase tracking-wider text-sky-400">Engineering Highlights</span>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-2">
				Built for reliability, privacy, and zero overhead
			</h2>
			<p class="text-slate-300 mt-4 text-base leading-relaxed">
				Engineered as a clean Windows utility using CustomTkinter and Playwright. Every feature is designed with practical desktop integration in mind.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
			{
				ENGINEERING_FEATURES.map((feature) => {
					const IconComponent = FEATURE_ICONS[feature.icon];
					return (
						<div class="group relative rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-6 flex flex-col justify-between hover:border-slate-700 hover:bg-slate-900/90 transition-all">
							<div>
								<div class="flex items-center justify-between mb-4">
									<div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center group-hover:border-sky-500/40 group-hover:bg-sky-500/15 transition-all">
										<IconComponent class="w-5 h-5" />
									</div>
									<span class="text-[10px] font-mono font-medium text-slate-400 px-2.5 py-0.5 rounded bg-slate-950 border border-slate-800 group-hover:border-slate-700 transition-colors">
										{feature.tag}
									</span>
								</div>
								<h3 class="text-base font-bold text-white mb-2 tracking-tight group-hover:text-sky-300 transition-colors">
									{feature.title}
								</h3>
								<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
									{feature.description}
								</p>
							</div>

							<div class="mt-5 pt-3.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono">
								<span class="text-slate-500 uppercase tracking-wider text-[10px]">
									{feature.metaLabel}
								</span>
								<span class="text-slate-300">
									{feature.metaValue}
								</span>
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
