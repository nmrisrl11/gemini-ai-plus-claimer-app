---
import { CONFIG } from "../config";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const prefix = isHome ? "" : "/";
---

<header
	role="banner"
	class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/85 border-b border-slate-800/80 transition-colors"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
		<!-- App Brand & Logo -->
		<a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
			<div
				class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-lg overflow-hidden bg-slate-900 border border-slate-700/80 p-1 flex items-center justify-center transition-transform group-hover:scale-105"
			>
				<img
					src="/images/app_icon.png"
					alt="Google AI Plus Portal Logo"
					class="w-full h-full object-contain"
					width="36"
					height="36"
					loading="eager"
					fetchpriority="high"
					style="aspect-ratio: 1 / 1"
				/>
			</div>
			<div class="flex flex-col">
				<span
					class="font-bold text-sm sm:text-base text-slate-50 tracking-tight group-hover:text-sky-300 transition-colors"
				>
					Google AI Plus Portal
				</span>
				<span class="text-[10px] sm:text-[11px] text-slate-400 hidden xl:block"
					>1-Year Access Automation Utility</span
				>
			</div>
		</a>

		<!-- Option 2: Center Segmented Control Nav with Scrollspy -->
		<nav
			class="hidden lg:flex items-center p-1 rounded-xl bg-slate-900/90 border border-slate-800 shadow-inner"
			aria-label="Main Navigation"
		>
			<div class="flex items-center gap-1" id="nav-segmented-track">
				<a
					href={`${prefix}#how-it-works`}
					data-section="how-it-works"
					class="nav-tab px-3.5 py-1.5 text-xs font-medium rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 border border-transparent transition-all duration-150"
				>
					How It Works
				</a>
				<a
					href={`${prefix}#features`}
					data-section="features"
					class="nav-tab px-3.5 py-1.5 text-xs font-medium rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 border border-transparent transition-all duration-150"
				>
					Features
				</a>
				<a
					href={`${prefix}#browsers`}
					data-section="browsers"
					class="nav-tab px-3.5 py-1.5 text-xs font-medium rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 border border-transparent transition-all duration-150"
				>
					Compatibility
				</a>
				<a
					href={`${prefix}#faq`}
					data-section="faq"
					class="nav-tab px-3.5 py-1.5 text-xs font-medium rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 border border-transparent transition-all duration-150"
				>
					FAQ
				</a>
			</div>
		</nav>

		<!-- Right Actions: GitHub + Support Dev + Download CTA + Mobile Hamburger -->
		<div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
			<!-- GitHub Repository Link -->
			<a
				href={CONFIG.REPO_URL}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub Repository"
				class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-2 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-900 border border-transparent hover:border-slate-800 text-xs font-medium transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
					></path>
				</svg>
				<span class="hidden lg:inline">GitHub</span>
			</a>

			<!-- Support Dev Link -->
			<a
				href={`${prefix}#support`}
				class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-2 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-900 border border-transparent hover:border-slate-800 text-xs font-medium transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg
					class="w-3.5 h-3.5 text-rose-500 fill-current"
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
					></path>
				</svg>
				<span class="hidden xl:inline">Support</span>
			</a>

			<!-- Primary Download CTA -->
			<a
				href={CONFIG.LATEST_RELEASE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="direct-download-link hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-sky-700 hover:bg-sky-600 text-white text-xs sm:text-sm font-semibold tracking-wide shadow-sm transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg
					focusable="false"
					class="w-4 h-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
					></path>
				</svg>
				<span>Download</span>
			</a>

			<!-- Mobile Menu Toggle Button (visible below lg) -->
			<button
				id="mobile-menu-btn"
				type="button"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="lg:hidden inline-flex items-center justify-center p-2.5 min-h-[44px] min-w-[44px] rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/80 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg
					aria-hidden="true"
					focusable="false"
					id="menu-icon-bars"
					class="w-5 h-5 block"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"
					></path>
				</svg>
				<svg
					aria-hidden="true"
					focusable="false"
					id="menu-icon-close"
					class="w-5 h-5 hidden"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"
					></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer / Dropdown -->
	<div
		id="mobile-menu"
		class="hidden lg:hidden border-t border-slate-800 bg-slate-950/95 backdrop-blur-lg px-4 pt-3 pb-5 space-y-2 transition-all duration-200"
	>
		<nav
			class="flex flex-col space-y-1 text-sm font-medium text-slate-200"
			aria-label="Mobile Navigation"
		>
			<a
				href={`${prefix}#how-it-works`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
			>
				How It Works
			</a>
			<a
				href={`${prefix}#features`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
			>
				Features
			</a>
			<a
				href={`${prefix}#browsers`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
			>
				Compatibility
			</a>
			<a
				href={`${prefix}#faq`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
			>
				FAQ
			</a>
			<a
				href={CONFIG.REPO_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="mobile-nav-link block px-3 py-2.5 rounded-lg text-slate-200 hover:bg-slate-900 hover:text-white transition-colors"
			>
				Source Code
			</a>
			<a
				href={`${prefix}#support`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg text-slate-200 hover:bg-slate-900 hover:text-white transition-colors"
			>
				Support Dev
			</a>
		</nav>

		<div class="pt-3 border-t border-slate-800/80">
			<a
				href={CONFIG.LATEST_RELEASE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="direct-download-link mobile-nav-link w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-sky-700 hover:bg-sky-600 text-white font-semibold text-sm shadow transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg
					focusable="false"
					class="w-4 h-4 fill-current"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"
					></path>
				</svg>
				<span>Download Portable App</span>
			</a>
		</div>
	</div>
</header>

<script is:inline>
	// Mobile Drawer Navigation toggle logic
	const mobileMenuBtn = document.getElementById("mobile-menu-btn");
	const mobileMenu = document.getElementById("mobile-menu");
	const menuIconBars = document.getElementById("menu-icon-bars");
	const menuIconClose = document.getElementById("menu-icon-close");

	if (mobileMenuBtn && mobileMenu) {
		mobileMenuBtn.addEventListener("click", () => {
			const isOpen = !mobileMenu.classList.contains("hidden");
			if (isOpen) {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
			} else {
				mobileMenu.classList.remove("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "true");
				if (menuIconBars) menuIconBars.classList.add("hidden");
				if (menuIconClose) menuIconClose.classList.remove("hidden");
			}
		});

		// Close drawer on link click
		document.querySelectorAll(".mobile-nav-link").forEach((link) => {
			link.addEventListener("click", () => {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
			});
		});

		// Close on Escape key press (keyboard accessibility)
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
				mobileMenuBtn.focus();
			}
		});
	}

	// Scrollspy for Segmented Track (DOMContentLoaded safe, high accuracy)
	function initScrollspy() {
		const sections = [
			{ id: "how-it-works", tabKey: "how-it-works" },
			{ id: "features", tabKey: "features" },
			{ id: "browsers", tabKey: "browsers" },
			{ id: "requirements", tabKey: "browsers" },
			{ id: "faq", tabKey: "faq" },
		];

		const navTabs = document.querySelectorAll(".nav-tab");
		if (!navTabs.length) return;

		const activeClasses = [
			"bg-slate-800",
			"text-white",
			"font-semibold",
			"shadow-sm",
			"border-slate-700/80",
		];
		const inactiveClasses = ["text-slate-400", "font-medium", "border-transparent"];

		function setActiveTab(activeKey) {
			navTabs.forEach((tab) => {
				const target = tab.getAttribute("data-section");
				if (target === activeKey) {
					tab.classList.add(...activeClasses);
					tab.classList.remove(...inactiveClasses);
					tab.setAttribute("aria-current", "page");
				} else {
					tab.classList.remove(...activeClasses);
					tab.classList.add(...inactiveClasses);
					tab.removeAttribute("aria-current");
				}
			});
		}

		// Click activation (instant visual feedback)
		navTabs.forEach((tab) => {
			tab.addEventListener("click", () => {
				const target = tab.getAttribute("data-section");
				if (target) setActiveTab(target);
			});
		});

		let isTicking = false;
		function updateOnScroll() {
			const scrollY = window.scrollY;
			const viewportHeight = window.innerHeight;
			const docHeight = document.documentElement.scrollHeight;

			// If reached the very bottom of the page, highlight FAQ
			if (scrollY + viewportHeight >= docHeight - 80) {
				setActiveTab("faq");
				return;
			}

			// Header offset buffer
			const headerOffset = 140;
			const currentY = scrollY + headerOffset;

			// Check first section top
			const firstSection = document.getElementById("how-it-works");
			if (firstSection && currentY < firstSection.offsetTop) {
				setActiveTab("");
				return;
			}

			// Scan backwards to find the current active section
			let activeKey = "";
			for (let i = sections.length - 1; i >= 0; i--) {
				const item = sections[i];
				const el = document.getElementById(item.id);
				if (el && currentY >= el.offsetTop) {
					activeKey = item.tabKey;
					break;
				}
			}

			setActiveTab(activeKey);
		}

		window.addEventListener(
			"scroll",
			() => {
				if (!isTicking) {
					window.requestAnimationFrame(() => {
						updateOnScroll();
						isTicking = false;
					});
					isTicking = true;
				}
			},
			{ passive: true },
		);

		// Initial check on page load
		updateOnScroll();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initScrollspy);
	} else {
		initScrollspy();
	}
</script>
