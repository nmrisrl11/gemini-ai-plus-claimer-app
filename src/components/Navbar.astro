---
import { CONFIG } from "../config";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const prefix = isHome ? "" : "/";
---

<header
	role="banner"
	class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/90 border-b border-slate-800"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
		<!-- App Brand & Logo -->
		<a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
			<div
				class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-lg overflow-hidden bg-slate-900 border border-slate-700/80 p-1 flex items-center justify-center transition-transform group-hover:scale-105"
			>
				<img
					src="/images/app_icon.png"
					alt="Google AI Plus Portal Logo"
					class="w-full h-full object-contain"
					width="36"
					height="36"
					loading="eager"
					fetchpriority="high"
					style="aspect-ratio: 1 / 1"
				/>
			</div>
			<div class="flex flex-col">
				<span
					class="font-bold text-sm sm:text-base text-slate-50 tracking-tight group-hover:text-sky-300 transition-colors"
				>
					Google AI Plus Portal
				</span>
				<span class="text-[10px] sm:text-[11px] text-slate-400 hidden sm:block"
					>1-Year Access Automation Utility</span
				>
			</div>
		</a>

		<!-- Desktop Nav Links -->
		<nav
			class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-300"
			aria-label="Main Navigation"
		>
			<a href={`${prefix}#overview`} class="hover:text-sky-400 transition-colors">Overview</a>
			<a href={`${prefix}#how-it-works`} class="hover:text-sky-400 transition-colors">How It Works</a>
			<a href={`${prefix}#features`} class="hover:text-sky-400 transition-colors">Features</a>
			<a href={`${prefix}#browsers`} class="hover:text-sky-400 transition-colors">Browsers</a>
			<a href={`${prefix}#requirements`} class="hover:text-sky-400 transition-colors">Requirements</a>
			<a href={`${prefix}#support`} class="hover:text-sky-400 transition-colors">Support Dev</a>
			<a href={`${prefix}#faq`} class="hover:text-sky-400 transition-colors">FAQ</a>
		</nav>

		<!-- Desktop Download Button + Mobile Menu Toggle -->
		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href={CONFIG.LATEST_RELEASE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="direct-download-link hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs sm:text-sm font-semibold tracking-wide shadow-sm transition-all duration-150"
			>
				<svg
					focusable="false"
					class="w-4 h-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
					></path>
				</svg>
				<span>Download</span>
			</a>

			<!-- Mobile Menu Toggle Button (visible below lg) -->
			<button
				id="mobile-menu-btn"
				type="button"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="lg:hidden inline-flex items-center justify-center p-2.5 min-h-[44px] min-w-[44px] rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/80 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400"
			>
				<svg
					aria-hidden="true"
					focusable="false"
					id="menu-icon-bars"
					class="w-5 h-5 block"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"
					/>
				</svg>
				<svg
					aria-hidden="true"
					focusable="false"
					id="menu-icon-close"
					class="w-5 h-5 hidden"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"
					/>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer / Dropdown -->
	<div
		id="mobile-menu"
		class="hidden lg:hidden border-t border-slate-800 bg-slate-950/95 backdrop-blur-lg px-4 pt-3 pb-5 space-y-2 transition-all duration-200"
	>
		<nav
			class="flex flex-col space-y-1 text-sm font-medium text-slate-200"
			aria-label="Mobile Navigation"
		>
			<a
				href={`${prefix}#overview`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>Overview</a
			>
			<a
				href={`${prefix}#how-it-works`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>How It Works</a
			>
			<a
				href={`${prefix}#features`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>Features</a
			>
			<a
				href={`${prefix}#browsers`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>Browsers</a
			>
			<a
				href={`${prefix}#requirements`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>Requirements</a
			>
			<a
				href={`${prefix}#support`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>Support Dev</a
			>
			<a
				href={`${prefix}#faq`}
				class="mobile-nav-link block px-3 py-2.5 rounded-lg hover:bg-slate-900 hover:text-sky-400 transition-colors"
				>FAQ</a
			>
		</nav>

		<div class="pt-3 border-t border-slate-800/80">
			<a
				href={CONFIG.LATEST_RELEASE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="direct-download-link mobile-nav-link w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-sm shadow transition-colors"
			>
				<svg
					focusable="false"
					class="w-4 h-4 fill-current"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"
					/>
				</svg>
				<span>Download Portable App</span>
			</a>
		</div>
	</div>
</header>

<script is:inline>
	// Mobile Drawer Navigation toggle logic
	const mobileMenuBtn = document.getElementById("mobile-menu-btn");
	const mobileMenu = document.getElementById("mobile-menu");
	const menuIconBars = document.getElementById("menu-icon-bars");
	const menuIconClose = document.getElementById("menu-icon-close");

	if (mobileMenuBtn && mobileMenu) {
		mobileMenuBtn.addEventListener("click", () => {
			const isOpen = !mobileMenu.classList.contains("hidden");
			if (isOpen) {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
			} else {
				mobileMenu.classList.remove("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "true");
				if (menuIconBars) menuIconBars.classList.add("hidden");
				if (menuIconClose) menuIconClose.classList.remove("hidden");
			}
		});

		// Close drawer on link click
		document.querySelectorAll(".mobile-nav-link").forEach((link) => {
			link.addEventListener("click", () => {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
			});
		});

		// Close on Escape key press (keyboard accessibility)
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
				mobileMenu.classList.add("hidden");
				mobileMenuBtn.setAttribute("aria-expanded", "false");
				if (menuIconBars) menuIconBars.classList.remove("hidden");
				if (menuIconClose) menuIconClose.classList.add("hidden");
				mobileMenuBtn.focus();
			}
		});
	}
</script>
