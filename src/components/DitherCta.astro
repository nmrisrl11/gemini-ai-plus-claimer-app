---
import { CONFIG } from "../config";
import { DITHER_CTA_DESCRIPTION, DITHER_CTA_TITLE } from "../constants/dither-cta";
import WindowsIcon from "./icons/WindowsIcon.astro";

interface Props {
	/**
	 * Origin of the dither spotlight dome: "top" | "bottom" | "center".
	 * Default: "top" (per user preference to view top-to-bottom fade).
	 */
	position?: "top" | "bottom" | "center";
	/**
	 * Radius reach factor (0.0 to 1.0). Default: 0.68
	 */
	radius?: number;
	/**
	 * Brightness intensity (0.0 to 1.0). Default: 0.75
	 */
	intensity?: number;
}

const { position = "top", radius = 0.68, intensity = 0.75 } = Astro.props;
---

<!-- Retro WebGL Dither Call To Action Section (dithercn glow spotlight) -->
<section
	id="download-cta"
	aria-label="Download Google AI Plus Portal"
	class="relative pt-16 pb-20 sm:pt-24 sm:pb-28 md:pt-28 md:pb-36 border-t border-slate-800 bg-slate-950 overflow-hidden"
>
	<!-- WebGL Bayer-8 Dither Canvas with configurable position, radius, and intensity props -->
	<canvas
		id="dither-canvas"
		data-position={position}
		data-radius={radius}
		data-intensity={intensity}
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 w-full h-full select-none"
	></canvas>

	<!-- Content Container -->
	<div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
		<!-- 1. Centered Official App Logo (No Background Box, Prominent & Tilted Hero Icon) -->
		<div class="relative mb-6 sm:mb-8 group flex items-center justify-center select-none">
			<div class="relative w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 flex items-center justify-center -rotate-6">
				<img
					src="/images/app_icon.png"
					alt="Google AI Plus Portal Icon"
					width="128"
					height="128"
					class="w-full h-full object-contain select-none"
					loading="lazy"
					decoding="async"
					draggable="false"
				/>
			</div>
		</div>

		<!-- 2. Clean Single Line Section Title -->
		<h2
			class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight mb-4 max-w-3xl mx-auto md:whitespace-nowrap"
		>
			{DITHER_CTA_TITLE}
		</h2>

		<!-- 3. Conversion Copywriting Description -->
		<p
			class="text-sm sm:text-base md:text-lg text-slate-300 leading-relaxed mb-8 sm:mb-10 max-w-2xl mx-auto"
		>
			{DITHER_CTA_DESCRIPTION}
		</p>

		<!-- 4. Primary CTA Download Button (Engraved Pop Style) -->
		<div>
			<a
				id="btn-download-dither-cta"
				href={CONFIG.LATEST_RELEASE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="direct-download-link btn-engraved-primary inline-flex items-center justify-center gap-3 px-8 py-3.5 sm:px-9 sm:py-4 rounded-xl font-semibold text-sm sm:text-base"
			>
				<WindowsIcon class="w-5 h-5 fill-current shrink-0" />
				<span>Download for Windows (64-bit)</span>
			</a>
		</div>
	</div>
</section>

<script src="../scripts/dither-canvas.ts"></script>
