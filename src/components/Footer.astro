---
import { ArrowUp as ArrowUpIcon, ExternalLink as ExternalLinkIcon } from "@lucide/astro";
import { CONFIG } from "../config";
import { FOOTER_COLUMNS } from "../constants/footer";

interface Props {
	withBorder?: boolean;
	pt?: string;
}

const { withBorder, pt } = Astro.props;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const prefix = isHome ? "" : "/";
const showBorder = withBorder ?? !isHome;
const topPadding = pt ?? (isHome ? "pt-0" : "pt-16");
---

<footer
	role="contentinfo"
	class:list={[
		"bg-slate-950 text-slate-400 text-xs pb-12",
		topPadding,
		showBorder ? "border-t border-slate-800" : "border-t-0",
	]}
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
		<!-- Top Section: Brand Overview (Left) + Multi-Column Navigation (Right) -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
			<!-- Col 1-2: Brand, Purpose & Badges -->
			<div class="lg:col-span-2 space-y-4 pr-0 lg:pr-8">
				<a href="/" class="flex items-center gap-3 group">
					<div
						class="w-8 h-8 rounded-lg overflow-hidden bg-slate-900 border border-slate-700/80 p-1 flex items-center justify-center transition-transform group-hover:scale-105"
					>
						<img
							src="/images/app_icon.png"
							alt="Google AI Plus Portal Logo"
							class="w-full h-full object-contain"
							width="32"
							height="32"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="flex items-center gap-2">
						<span class="font-bold text-white text-base tracking-tight group-hover:text-sky-300 transition-colors">
							Google AI Plus Portal
						</span>
						<span class="text-[10px] font-mono font-semibold text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 rounded-full">
							{CONFIG.VERSION}
						</span>
					</div>
				</a>

				<p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
					Standalone Windows automation utility engineered for 1-click educational promotion redemption. Local-first, zero cloud dependencies, and Playwright-driven.
				</p>

				<!-- Engineering Badges -->
				<div class="flex flex-wrap items-center gap-2 pt-1 text-[11px] font-mono">
					<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-slate-400">
						100% Local Execution
					</span>
					<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-slate-400">
						Zero Telemetry
					</span>
				</div>
			</div>

			<!-- Col 3, 4, 5: Categorized Navigation Links -->
			{
				FOOTER_COLUMNS.map((col) => (
					<div class="space-y-3">
						<h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300">
							{col.title}
						</h3>
						<ul class="space-y-2 text-xs">
							{col.links.map((link) => {
								const href = link.external ? link.href : `${prefix}${link.href}`;
								return (
									<li>
										<a
											href={href}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noopener noreferrer" : undefined}
											class="inline-flex items-center gap-1 text-slate-400 hover:text-white transition-colors"
										>
											<span>{link.label}</span>
											{link.external && (
												<ExternalLinkIcon class="w-3 h-3 text-slate-500 shrink-0" />
											)}
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>

		<!-- Legal Disclaimer & Non-Affiliation (Quiet Editorial Footnote) -->
		<div class="pt-8 border-t border-slate-900 text-[11px] leading-relaxed text-slate-500 space-y-2">
			<p class="font-semibold text-slate-400">
				Disclaimer &amp; Non-Affiliation Notice:
			</p>
			<p>
				This software is an independent desktop automation utility provided strictly for personal convenience, educational testing, and research purposes. This project is <strong class="text-slate-400">not affiliated with, sponsored by, or endorsed by Google LLC, Alphabet Inc., or Internshala</strong>.
			</p>
			<p>
				Google, Google AI, Google One, and Gemini are registered trademarks of Google LLC. Internshala is a registered trademark of Scholiverse Educare Private Limited. All other trademarks belong to their respective owners.
			</p>
		</div>

		<!-- Bottom Copyright & Back to Top Bar -->
		<div class="pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
			<div>
				&copy; 2026 nmrisrl11 &bull; Website source under the <span class="text-slate-400">MIT License</span>.
			</div>
			<div class="flex items-center gap-4">
				<a
					href="#"
					id="back-to-top"
					class="inline-flex items-center gap-1.5 text-slate-400 hover:text-sky-300 transition-colors"
					aria-label="Back to top of page"
				>
					<span>Back to top</span>
					<ArrowUpIcon class="w-3.5 h-3.5" />
				</a>
			</div>
		</div>
	</div>
</footer>
