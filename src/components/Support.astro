---
import { Coffee as CoffeeIcon, Smartphone as SmartphoneIcon } from "@lucide/astro";
import { CONFIG } from "../config";
---

<!-- Support Developer Section -->
<section id="support" class="py-16 md:py-24 border-b border-slate-800 bg-slate-900/30">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl mx-auto text-center">
			<span class="text-xs font-bold uppercase tracking-wider text-amber-400">Support the Dev</span>
			<h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-2">
				Buy Me a Coffee
			</h2>
			<p class="text-slate-300 mt-3 text-base">
				Saved you some time? Buying a coffee won't hurt.<br />
				<span class="text-slate-400 text-sm">Totally optional, but always appreciated!</span>
			</p>

			<!-- QR Codes Card -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-lg mx-auto">
				<!-- Buy Me A Coffee QR -->
				<div
					class="p-5 rounded-xl border border-slate-800 bg-slate-900 flex flex-col items-center"
				>
					<span class="text-xs font-bold text-amber-400 mb-3 flex items-center gap-1.5">
						<CoffeeIcon class="w-4 h-4" />
						<span>Buy Me a Coffee</span>
					</span>
					<div
						class="w-40 h-40 rounded-lg bg-white p-2 flex items-center justify-center border border-slate-700"
					>
						<img
							src="/images/qrcode-bmc.png"
							alt="Buy Me A Coffee QR Code"
							class="w-full h-full object-contain"
							width="160"
							height="160"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<span class="text-[11px] text-slate-400 font-mono mt-3">Scan via Camera or BMC app</span>
				</div>

				<!-- GCash QR -->
				<div
					class="p-5 rounded-xl border border-slate-800 bg-slate-900 flex flex-col items-center"
				>
					<span class="text-xs font-bold text-sky-400 mb-3 flex items-center gap-1.5">
						<SmartphoneIcon class="w-4 h-4" />
						<span>GCash (Direct)</span>
					</span>
					<div
						class="w-40 h-40 rounded-lg bg-white p-2 flex items-center justify-center border border-slate-700"
					>
						<img
							src="/images/qrcode-gcash.JPG"
							alt="GCash QR Code"
							class="w-full h-full object-contain"
							width="160"
							height="160"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<span class="text-[11px] text-slate-400 font-mono mt-3">Scan via GCash App</span>
				</div>
			</div>

			<div class="mt-6 text-xs text-slate-400">
				Developer:
				<a
					href={CONFIG.DEV_GITHUB}
					target="_blank"
					rel="noopener noreferrer"
					class="text-sky-400 hover:underline"
					>@nmrisrl11</a
				>
				&bull; Desktop automation craft
			</div>
		</div>
	</div>
</section>
