---
import { ChevronDown as ChevronDownIcon } from "@lucide/astro";
import { FAQ_ITEMS } from "../constants/faq";
---

<!-- FAQ Section -->
<section id="faq" class="py-16 md:py-24">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
			<span class="text-xs font-bold uppercase tracking-wider text-sky-400">
				Frequently Asked Questions
			</span>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-2">
				Clear answers to common questions
			</h2>
			<p class="text-slate-400 mt-3 text-sm sm:text-base leading-relaxed">
				Everything you need to know about local execution, safety, and Google One redemption.
			</p>
		</div>

		<!-- Unified Accordion Container -->
		<div
			class="rounded-2xl border border-slate-800 bg-slate-900/40 divide-y divide-slate-800/80 overflow-hidden shadow-xl"
		>
			{
				FAQ_ITEMS.map((faq) => (
					<details class="group transition-colors hover:bg-slate-900/70 open:bg-slate-950/40">
						<summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer list-none text-sm sm:text-base font-semibold text-white group-hover:text-sky-300 transition-colors select-none">
							<span class="flex items-center gap-3.5 pr-4">
								<span class="font-mono text-xs font-bold text-sky-400 shrink-0">
									{faq.id}
								</span>
								<span>{faq.question}</span>
							</span>
							<div class="w-8 h-8 rounded-lg bg-slate-800/60 border border-slate-700/60 flex items-center justify-center text-slate-400 group-open:text-sky-400 group-open:bg-sky-500/10 group-open:border-sky-500/30 transition-all shrink-0">
								<ChevronDownIcon class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" />
							</div>
						</summary>
						<div class="px-5 sm:px-6 pb-5 sm:pb-6 text-xs sm:text-sm text-slate-400 leading-relaxed pt-2 border-t border-slate-800/40">
							<p class="pl-0 sm:pl-7">{faq.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
