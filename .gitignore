# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor directories and files (keep project settings, ignore user state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Executables and builds (binary releases should be uploaded via GitHub Releases, not git tree)
*.exe
dist/
build/
